<h1 class="page-title"><%= title %></h1>

<%- messages() %>

<% if (errors && errors.length) { %>
  <ul class="notice">
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<div class="form-container">
  <form action="/inv/add-classification" method="post" class="form">
    <label for="classification_name">
      Classification Name
      <small>Letters and numbers only. No spaces or special characters.</small>
    </label>

    <input
      type="text"
      id="classification_name"
      name="classification_name"
      pattern="^[A-Za-z0-9]+$"
      required
      value="<%= classification_name || '' %>"
    >

    <button type="submit">Add Classification</button>
  </form>
</div>
