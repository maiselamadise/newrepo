<%- include("../partials/header") %>

<h1><%= title %></h1>

<% if (errors) { %>
  <p class="error"><%= errors %></p>
<% } %>

<form method="POST" action="/inv/add-inventory">
  <label>Make</label>
  <input name="inv_make" required>

  <label>Model</label>
  <input name="inv_model" required>

  <label>Year</label>
  <input type="number" name="inv_year" required>

  <label>Price</label>
  <input type="number" step="0.01" name="inv_price" required>

  <label>Classification</label>
  <%- classificationSelect %>

  <button type="submit">Add Inventory</button>
</form>

module.exports = {
  buildManagement,
  buildByClassification,
  buildDetail,
  buildAddClassification,
  addClassification,
  buildAddInventory,
  addInventory,
}
<%- include("../partials/footer") %>



