<%- include("../partials/header") %>

<main>
  <h1>Add New Vehicle</h1>

  <% if (errors && errors.length > 0) { %>
    <div class="error-list">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/inventory/add" method="post" novalidate>
    
    <!-- Classification -->
    <label for="classification_id">
      Classification
    </label>
    <%- classificationSelect %>

    <!-- Make -->
    <label for="inv_make">
      Make
    </label>
    <input
      type="text"
      id="inv_make"
      name="inv_make"
      required
      minlength="2"
      value="<%= vehicle?.inv_make ?? '' %>"
    >

    <!-- Model -->
    <label for="inv_model">
      Model
    </label>
    <input
      type="text"
      id="inv_model"
      name="inv_model"
      required
      minlength="2"
      value="<%= vehicle?.inv_model ?? '' %>"
    >

    <!-- Year -->
    <label for="inv_year">
      Year
    </label>
    <input
      type="number"
      id="inv_year"
      name="inv_year"
      required
      min="1900"
      max="2099"
      value="<%= vehicle?.inv_year ?? '' %>"
    >

    <!-- Description -->
    <label for="inv_description">
      Description
    </label>
    <textarea
      id="inv_description"
      name="inv_description"
      required
      minlength="10"
    ><%= vehicle?.inv_description ?? '' %></textarea>

    <!-- Image path -->
    <label for="inv_image">
      Image Path
    </label>
    <input
      type="text"
      id="inv_image"
      name="inv_image"
      required
      value="<%= vehicle?.inv_image ?? '/images/vehicles/no-image.png' %>"
    >

    <!-- Thumbnail path -->
    <label for="inv_thumbnail">
      Thumbnail Path
    </label>
    <input
      type="text"
      id="inv_thumbnail"
      name="inv_thumbnail"
      required
      value="<%= vehicle?.inv_thumbnail ?? '/images/vehicles/no-image-tn.png' %>"
    >

    <!-- Price -->
    <label for="inv_price">
      Price
    </label>
    <input
      type="number"
      id="inv_price"
      name="inv_price"
      required
      min="0"
      step="0.01"
      value="<%= vehicle?.inv_price ?? '' %>"
    >

    <!-- Miles -->
    <label for="inv_miles">
      Miles
    </label>
    <input
      type="number"
      id="inv_miles"
      name="inv_miles"
      required
      min="0"
      value="<%= vehicle?.inv_miles ?? '' %>"
    >

    <!-- Color -->
    <label for="inv_color">
      Color
    </label>
    <input
      type="text"
      id="inv_color"
      name="inv_color"
      required
      value="<%= vehicle?.inv_color ?? '' %>"
    >

    <button type="submit">
      Add Vehicle
    </button>
  </form>
</main>

<%- include("../partials/footer") %>
